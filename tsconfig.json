{
	"compilerOptions": {
		"strict": true,
		"module": "commonjs",
		"moduleResolution": "node",
		"target": "es2019",
		"lib": ["es2019", "es2020", "es2022.error"],
		"removeComments": true,
		"useUnknownInCatchVariables": false,
		"forceConsistentCasingInFileNames": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"strictNullChecks": true,
		"preserveConstEnums": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		// No declarations: nothing imports this package as a library — n8n loads
		// the compiled node classes by path. Emitting them also fails the official
		// security scan, whose `cred-filename-against-convention` rule sees
		// `AcaApi.credentials.d.ts` and asks for it to be renamed to `.ts`.
		// No incremental build info either, so it does not end up in the tarball.
		"incremental": false,
		"declaration": false,
		"sourceMap": true,
		"skipLibCheck": true,
		"outDir": "./dist/"
	},
	"include": ["credentials/**/*", "nodes/**/*", "nodes/**/*.json", "package.json"]
}
